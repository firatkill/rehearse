APP_EDITION=full
OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna
CHAT_MODEL_SUPPORTS_TEMPERATURE=false
CHAT_REASONING_EFFORT=none
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHED_INPUT_PER_MTOK=0.01
# Generate each secret separately with: openssl rand -hex 32
SESSION_SECRET=
IP_HASH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONTHLY_BUDGET_USD=5
# Optional on localhost; required before exposing the app. Basic Auth username: rehearse
APP_PASSWORD=
# Optional AI reading after free job-link reading fails: USD per web-search tool call.
# Set this to your OpenAI web-search price to enable the cost-labelled action.
PRICE_WEB_SEARCH_PER_CALL=0.01

# Question generation from job posts only. Feedback and scoring always use CHAT_MODEL.
# Analysis also uses this provider/model. Blank model/prices retain CHAT_MODEL/OpenAI defaults.
JOBPOST_PROVIDER=openai
JOBPOST_MODEL=
JOBPOST_PRICE_INPUT_PER_MTOK=
JOBPOST_PRICE_OUTPUT_PER_MTOK=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional interviewer speech, full edition only. Browser speech is free and remains the fallback.
TTS_PROVIDER=browser
TTS_MODEL=
TTS_VOICE=
# USD per million characters, or per generated audio minute when TTS_PRICE_UNIT=minute.
# For token-priced audio, configure an estimated effective rate; budget totals are estimates.
TTS_PRICE=
TTS_PRICE_UNIT=characters
ELEVENLABS_API_KEY=
