# Development only. Production secrets: generate separately with openssl rand -hex 32.
LLM_MODE=mock
OPENAI_API_KEY=
# Live CHAT_MODEL is pinned in T-24; mock needs no model or API key.
CHAT_MODEL=
CHAT_MODEL_SUPPORTS_TEMPERATURE=true
CHAT_REASONING_EFFORT=
MAX_OUTPUT_TOKENS_FEEDBACK=900
MAX_OUTPUT_TOKENS_SUMMARY=400
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
PRICE_CACHED_INPUT_PER_MTOK=
DEMO_MODE=on
SESSION_SECRET=dev-only-session-secret-change-me-00000000000
SESSION_SECRET_PREVIOUS=
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me-00000000000
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SESSIONS_PER_IP_DAILY=3
RATE_LIMIT_FEEDBACK_PER_IP_DAILY=20
RATE_LIMIT_GLOBAL_LLM_DAILY=150
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=
LOG_LEVEL=info
MOCK_LLM_DELAY_MS=300
EVAL_MAX_COST_USD=0.50
EVAL_REPEATS=2
# Platform-owned variables; do not set locally:
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_GIT_COMMIT_SHA=
# NODE_ENV=
# GITHUB_STEP_SUMMARY=

# Optional Playwright-only override; defaults to ports 3200–3203.
# E2E_BASE_PORT=3240
